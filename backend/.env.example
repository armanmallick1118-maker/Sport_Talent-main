# ==============================================================================
# Required environment variables for all features to work:
# ==============================================================================

# Prisma DB connection
DATABASE_URL="file:./dev.db"

# Auth tokens
JWT_SECRET="replace_me_with_a_long_random_secret"

# Server port
PORT=8000

# Google Gemini — (news bot, AI suggestions)
GEMINI_API_KEY="replace_me_with_your_gemini_api_key"

# Groq — (Coach Jack, AI suggestions fallback)
GROQ_API_KEY="replace_me_with_your_groq_api_key"
GROQ_PRIMARY_MODEL="openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL="qwen/qwen3.8-27b"

# CORS allowlist — (Vercel frontend URL / Localhost)
FRONTEND_URL="http://localhost:3000"

# External sports news source (optional)
NEWS_API_KEY=""
